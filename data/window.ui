<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0 -->
<interface>
  <!-- interface-name window.ui -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.5"/>
  <template class="MainWindow" parent="AdwApplicationWindow">
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="title-widget">
                  <object class="AdwWindowTitle" id="window_title">
                    <property name="title">Столовая</property>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                    <property name="primary">True</property>
                    <property name="tooltip-text">Главное меню</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="margin-bottom">24</property>
                <property name="margin-end">24</property>
                <property name="margin-start">24</property>
                <property name="margin-top">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">auth-smartcard-symbolic</property>
                    <property name="margin-bottom">12</property>
                    <property name="pixel-size">128</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Приложите карточку</property>
                    <style>
                      <class name="title-1"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">к считывателю, чтобы получить завтрак или обед</property>
                    <property name="wrap">True</property>
                    <property name="justify">center</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="homogeneous">True</property>
                    <property name="margin-top">24</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <style>
                          <class name="card"/>
                        </style>
                        <child>
                          <object class="GtkLabel" id="breakfast_count">
                            <property name="label">0</property>
                            <property name="margin-top">12</property>
                            <style>
                              <class name="title-1"/>
                              <class name="numeric"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">завтраков сегодня</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-end">24</property>
                            <property name="margin-start">24</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <style>
                          <class name="card"/>
                        </style>
                        <child>
                          <object class="GtkLabel" id="lunch_count">
                            <property name="label">0</property>
                            <property name="margin-top">12</property>
                            <style>
                              <class name="title-1"/>
                              <class name="numeric"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">обедов сегодня</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-end">24</property>
                            <property name="margin-start">24</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <child type="bottom">
              <object class="GtkBox" id="simulation_bar">
                <property name="halign">center</property>
                <property name="margin-bottom">6</property>
                <property name="margin-end">6</property>
                <property name="margin-start">6</property>
                <property name="margin-top">6</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Тестовый режим:</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="card_entry">
                    <property name="input-purpose">digits</property>
                    <property name="placeholder-text">Номер карточки</property>
                    <property name="width-chars">20</property>
                    <signal name="activate" handler="on_simulate_card"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="label">Приложить карточку</property>
                    <signal name="clicked" handler="on_simulate_card"/>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
    <property name="default-height">600</property>
    <property name="default-width">800</property>
    <property name="title">Столовая</property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label">Ученики</attribute>
        <attribute name="action">app.students</attribute>
      </item>
      <item>
        <attribute name="label">Обновить Excel-файл</attribute>
        <attribute name="action">app.export</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label">О программе</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
